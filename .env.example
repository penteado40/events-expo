# Copy to .env (ignored by git). Expo inlines EXPO_PUBLIC_* at build time: restart `expo start`
# after changing it. Development builds default to http://localhost:3000/api/v1; a release build
# without it fails at startup.

# iOS simulator (shares the Mac's network):
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Android emulator (10.0.2.2 is the Mac's localhost):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# A physical device on the same Wi-Fi (the Mac's LAN IP, e.g. `ipconfig getifaddr en0`):
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000/api/v1

# Clerk (events-api ADR-0020): the app's publishable key, from the Clerk dashboard (API keys).
# A development build without it offers only Demo mode; a release build without it fails at
# startup. In the Clerk dashboard: Restricted sign-up mode (no open sign-up), Google and Apple
# connections, and for Apple's native sheet on iOS the app's Bundle ID and Apple Team ID.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# The deploys (docs/previews.md) take these two from API_URL and CLERK_PUBLISHABLE_KEY (Vercel
# refuses names containing PUBLIC): `npm run build:web` maps them, and refuses a pk_live_ key.

# Demo build (ADR-0005): only Demo mode, without the events-api or Clerk. No deploy sets it; for a
# backend-less build run `npm run build:demo:web`. Leave it unset here.
# EXPO_PUBLIC_DEMO_BUILD=true
